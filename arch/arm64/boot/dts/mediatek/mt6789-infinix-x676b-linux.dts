			no-map;
		};

		scp@bfa00000 {
			reg = <0x00 0xbfa00000 0x00 0x400000>;
			no-map;
		};

		dfdmcu_dump@fd000000 {
			reg = <0x00 0xfd000000 0x00 0x100000>;
			no-map;
		};

		crypto_hw@48401000 {
