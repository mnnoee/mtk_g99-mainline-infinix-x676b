					pinmux = <0x3402>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			vow_dat_miso_off {
				phandle = <0x39>;

				pins_cmd1_dat {
					pinmux = <0xaf00>;
					input-enable;
					bias-pull-down;
				};
			};

			vow_dat_miso_on {
				phandle = <0x3a>;

				pins_cmd1_dat {
					pinmux = <0xaf04>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			vow_clk_miso_off {
				phandle = <0x3b>;

				pins_cmd1_dat {
					pinmux = <0xb000>;
					input-enable;
					bias-pull-down;
				};
			};

			vow_clk_miso_on {
				phandle = <0x3c>;

				pins_cmd1_dat {
					pinmux = <0xb004>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			cam0_mclk_pins: cam0-mclk-pins {
				pins_cmd_dat {
					pinmux = <0x7f01>;
					slew-rate = <0x01>;
					drive-strength = <0x04>;
				};
			};
		};

		serial@11002000 {
			compatible = "mediatek,mt6577-uart";
			reg = <0x11002000 0x1000>;
			interrupts = <0x00 0x8d 0x04 0x00>;
			clocks = <0x0e 0x0e>;
			clock-names = "baud", "bus";
			status = "okay";
		};

		serial@11003000 {
			compatible = "mediatek,mt6577-uart";
			reg = <0x11003000 0x1000>;
			interrupts = <0x00 0x18e 0x04 0x00>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		usb0@11200000 {
			compatible = "mediatek,mt8518-musb", "mediatek,mtk-musb";
			reg = <0x11200000 0x10000>;
			interrupts = <0x00 0x80 0x04 0x00>;
			interrupt-names = "mc";
			phys = <0x0f 0x03>;
			clocks = <0x0e 0x0e 0x0e>;
			clock-names = "main", "mcu", "univpll";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;
			status = "okay";
			dr_mode = "otg";
			maximum-speed = "high-speed";
		};

		t-phy@11f40000 {
			compatible = "mediatek,mt6789-tphy", "mediatek,generic-tphy-v2";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;
			status = "okay";

			usb-phy@11f40000 {
				reg = <0x00 0x11f40000 0x00 0x700>;
				clocks = <0x0e>;
				clock-names = "ref";
				#phy-cells = <0x01>;
				status = "okay";
				mediatek,eye-vrt = <0x04>;
				mediatek,eye-term = <0x04>;
				mediatek,rev4 = <0x01>;
				mediatek,rx_sqth = <0x05>;
				mediatek,discth = <0x07>;
				phandle = <0x0f>;
			};
		};

		wifi@18000000 {
			compatible = "mediatek,wifi";
			reg = <0x18000000 0x100000>;
			interrupts = <0x00 0x199 0x04 0x00>;
			memory-region = <0x46>;
			emi-addr = <0x7d000000>;
			emi-size = <0x600000>;
			emi-alignment = <0x1000000>;
			emi-max-addr = <0xc0000000>;
		};

		btif@1100c000 {
			compatible = "mediatek,btif";
			reg = <0x1100c000 0x1000 0x10217b00 0x80 0x10217b80 0x80>;
			interrupts = <0x00 0xbe 0x04 0x00 0x00 0xb8 0x04 0x00 0x00 0xb9 0x04 0x00>;
			clocks = <0x11 0x12 0x11 0x3d>;
			clock-names = "btifc", "apdmac";
		};

		consys@18002000 {
			compatible = "mediatek,mt6789-consys";
			#thermal-sensor-cells = <0x00>;
			reg = <0x18002000 0x1000 0x10007000 0x100 0x10001000 0x1000 0x10006000 0x1000 0x18007000 0x1000 0x180b1000 0x1000 0x180a3000 0x1000 0x180a5000 0x800 0x180c1000 0x1000 0x18004000 0x1000 0x1024c000 0x40 0x10003000 0x1000>;
			interrupts = <0x00 0x19a 0x04 0x00 0x00 0x6f 0x04 0x00 0x00 0x19b 0x04 0x00>;
			clocks = <0x11 0x38>;
			clock-names = "ccif";
			power-domains = <0x23 0x01>;
			pmic = <0x47>;
			emi-addr = <0x00>;
			emi-size = <0x600000>;
			emi-alignment = <0x1000000>;
			emi-max-addr = <0x80000000>;
			memory-region = <0x48>;
			vcn18-supply = <0x49>;
			vcn28-supply = <0x4a>;
			vcn33_bt-supply = <0x4b>;
			vcn33_wifi-supply = <0x4b>;
			status = "okay";
		};

		mmc@11240000 {
			compatible = "mediatek,mt8183-mmc";
			reg = <0x11240000 0x1000 0x11ef0000 0x1000>;
			clocks = <0x10 0x74 0x11 0x15 0x11 0x1c>;
			clock-names = "source", "hclk", "source_cg";
			interrupts = <0x00 0x87 0x04 0x00>;
			bus-width = <0x04>;
			max-frequency = <0xbebc200>;
			ocr-voltage = <0x30000>;
			cap-sd-highspeed;
			vmmc-supply = <0x4c>;
			vqmmc-supply = <0x4d>;
			pinctrl-names = "default", "state_uhs";
			pinctrl-0 = <0x14>;
			pinctrl-1 = <0x14>;
			no-mmc;
			no-sdio;
			builtin-cd = <0x00>;
			status = "okay";
			r_smpl = <0x00>;
			cd-gpios = <0x0d 0x07 0x00>;
		};

		ufs-phy@11fa0000 {
			compatible = "mediatek,mt6789-ufsphy", "mediatek,mt8183-ufsphy";
			reg = <0x11fa0000 0xc000>;
			clocks = <0x11 0x29 0x11 0x2b>;
			clock-names = "unipro", "mp";
			#phy-cells = <0x00>;
			phandle = <0x34>;
			status = "okay";
		};

		ufshci@11270000 {
			compatible = "mediatek,mt6789-ufshci", "mediatek,mt8183-ufshci";
			reg = <0x11270000 0x2300>;
			interrupts = <0x00 0x89 0x04 0x00>;
			phys = <0x34>;
			clocks = <0x11 0x2f 0x10 0x86>;
			clock-names = "ufs", "ufs_sel";
			freq-table-hz = <0x00 0x00 0x00 0x00>;
			resets = <0x11 0x01 0x11 0x02 0x11 0x03>;
			reset-names = "hci_rst", "unipro_rst", "crypto_rst";
			mediatek,ufs-disable-mcq;
			mediatek,ufs-broken-vcc;
			status = "okay";
		};

		i2c@11e00000 {
			compatible = "mediatek,mt6789-i2c", "mediatek,mt8781-i2c";
			reg = <0x11e00000 0x1000 0x10217080 0x80>;
			interrupts = <0x00 0x90 0x04 0x00>;
			clock-names = "main", "dma";
			clocks = <0x31 0x00 0x11 0x3d>;
			clock-div = <0x01>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			touchscreen@38 {
				compatible = "focaltech,ft5452";
				reg = <0x38>;
				interrupt-parent = <0x0d>;
				interrupts = <0x09 0x02>;
				reset-gpios = <0x0d 0x98 0x01>;
				vcc-supply = <0x4e>;
			};
		};

		i2c@11e01000 {
			compatible = "mediatek,mt6789-i2c", "mediatek,mt8781-i2c";
			reg = <0x11e01000 0x1000 0x10217100 0x80>;
			interrupts = <0x00 0x91 0x04 0x00>;
			clock-names = "main", "dma";
			clocks = <0x31 0x01 0x11 0x3d>;
			clock-div = <0x01>;
		};

		i2c@11eb0000 {
			compatible = "mediatek,mt6789-i2c", "mediatek,mt8781-i2c";
			reg = <0x11eb0000 0x1000 0x10217180 0x80>;
			interrupts = <0x00 0x92 0x04 0x00>;
			clock-names = "main", "dma";
			clocks = <0x32 0x00 0x11 0x3d>;
			clock-div = <0x01>;
		};

		i2c@11015000 {
			compatible = "mediatek,mt6789-i2c", "mediatek,mt8781-i2c";
			reg = <0x11015000 0x1000 0x10217280 0x80>;
			interrupts = <0x00 0x93 0x04 0x00>;
			clock-names = "main", "dma";
			clocks = <0x30 0x00 0x11 0x3d>;
			clock-div = <0x01>;
		};

		i2c@11eb1000 {
			compatible = "mediatek,mt6789-i2c", "mediatek,mt8781-i2c";
			reg = <0x11eb1000 0x1000 0x10217300 0x80>;
			interrupts = <0x00 0x94 0x04 0x00>;
			clock-names = "main", "dma";
			clocks = <0x32 0x01 0x11 0x3d>;
			clock-div = <0x01>;
		};

		i2c@11017000 {
			compatible = "mediatek,mt6789-i2c", "mediatek,mt8781-i2c";
			reg = <0x11017000 0x1000 0x10217400 0x80>;
			interrupts = <0x00 0x95 0x04 0x00>;
			clock-names = "main", "dma";
			clocks = <0x30 0x01 0x11 0x3d>;
			clock-div = <0x01>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			charger@53 {
				compatible = "richtek,rt9471";
				reg = <0x53>;
				wakeup-source;
				interrupts-extended = <0x0d 0x04 0x02>;
				status = "okay";
				phandle = <0x1c>;

				usb-otg-vbus-regulator {
					regulator-name = "usb-otg-vbus";
					regulator-min-microvolt = <0x4a0150>;
					regulator-max-microvolt = <0x50df20>;
					regulator-min-microamp = <0x7a120>;
					regulator-max-microamp = <0x124f80>;
				};
			};
		};

		i2c@1101a000 {
			compatible = "mediatek,mt6789-i2c", "mediatek,mt8781-i2c";
			reg = <0x1101a000 0x1000 0x10217480 0x80>;
			interrupts = <0x00 0x96 0x04 0x00>;
			clock-names = "main", "dma";
			clocks = <0x30 0x02 0x11 0x3d>;
			clock-div = <0x01>;
		};

		i2c@11f00000 {
			compatible = "mediatek,mt6789-i2c", "mediatek,mt8781-i2c";
			reg = <0x11f00000 0x1000 0x10217500 0x80>;
			interrupts = <0x00 0x97 0x04 0x00>;
			clock-names = "main", "dma";
			clocks = <0x33 0x00 0x11 0x3d>;
			clock-div = <0x01>;
		};

		i2c@11eb2000 {
			compatible = "mediatek,mt6789-i2c", "mediatek,mt8781-i2c";
			reg = <0x11eb2000 0x1000 0x10217600 0x80>;
			interrupts = <0x00 0x98 0x04 0x00>;
			clock-names = "main", "dma";
			clocks = <0x32 0x02 0x11 0x3d>;
			clock-div = <0x01>;
		};

		i2c@11eb3000 {
			compatible = "mediatek,mt6789-i2c", "mediatek,mt8781-i2c";
			reg = <0x11eb3000 0x1000 0x10217700 0x80>;
			interrupts = <0x00 0x99 0x04 0x00>;
			clock-names = "main", "dma";
			clocks = <0x32 0x03 0x11 0x3d>;
			clock-div = <0x01>;
		};

		watchdog@10007000 {
			compatible = "mediatek,mt8781-wdt", "mediatek,mt6589-wdt", "syscon";
			reg = <0x10007000 0x100>;

			reboot-mode {
				compatible = "syscon-reboot-mode";
				offset = <0x24>;
				mask = <0x0f>;
				mode-charger = <0x01>;
				mode-recovery = <0x02>;
				mode-bootloader = <0x03>;
				mode-dm-verity-dev-corrupt = <0x04>;
				mode-kpoc = <0x05>;
				mode-ddr-reserve = <0x06>;
				mode-meta = <0x07>;
				mode-rpmbpk = <0x08>;
			};
		};

		volume-down {
			compatible = "mediatek,mt6779-keypad";
			reg = <0x10010000 0x1000>;
			label = "vdown";
			1,code = <0x72>;
			mediatek,matrix-val = <0xbfdf>;
			mediatek,matrix-reg = <0x0c>;
			status = "okay";
		};

		volume-up {
			compatible = "mediatek,mt6779-keypad";
			reg = <0x10010000 0x1000>;
			label = "vup";
			1,code = <0x73>;
			mediatek,matrix-val = <0xdfef>;
			mediatek,matrix-reg = <0x0c>;
			status = "okay";
		};

		syscon@1a000000 {
			compatible = "mediatek,mt6789-camsys", "syscon";
			reg = <0x1a000000 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x2f0>;
		};

		md-probe@d0cf000 {
			compatible = "infinix,x676b-md-probe";
			reg = <0xd0cf000 0x1000>;
			vmodem-supply = <&vmodem>;
			status = "okay";
		};

		cam-mclk@1a004000 {
			compatible = "infinix,x676b-cam-mclk";
			reg = <0x1a004000 0x6000>;
			power-domains = <0x23 0x06>, <0x23 0x0c>;
			clocks = <0x10 0x6a>, <0x10 0x6b>, <0x10 0x21>, <0x2f0 0x03>, <0x2f0 0x04>;
			clock-names = "camtg-sel", "camtg2-sel", "mclk-freq", "camtg", "seninf";
			pinctrl-names = "default";
			pinctrl-0 = <&cam0_mclk_pins>;
			status = "okay";
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x0d 0x08 0x00 0x01 0x0e 0x08 0x00 0x01 0x0b 0x08 0x00 0x01 0x0a 0x08 0x00>;
	};

	aliases {
		serial0 = "/soc@0/serial@11002000";
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
	};

	display {
		compatible = "mediatek,mt6789-disp";
		bootph-all;
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x40000000 0x01 0x00>;
	};

	simple-framebuffer@feabe000 {
		compatible = "simple-framebuffer";
		status = "disabled";
		reg = <0x00 0xfeabe000 0x00 0x9e6000>;
		width = <0x438>;
		height = <0x960>;
		stride = <0x10e0>;
		format = "a8r8g8b8";
		width-mm = <0x46>;
		height-mm = <0x9b>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		wifi@bf000000 {
