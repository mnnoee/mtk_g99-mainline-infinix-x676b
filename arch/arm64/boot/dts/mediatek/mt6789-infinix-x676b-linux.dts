// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * Infinix Note 12 Pro (X676B, MT6789) - the device tree that actually boots.
 *
 * This file is the authoritative source for the DTB used on the device.  It
 * started life as "dtc -I dtb -O dts" of the minimal tree that was proven to
 * boot (display, touch, GPU, UFS, SD, USB, audio, battery, thermal) and then
 * gained the pieces that were missing there:
 *
 *   - i2c0 enabled, FocalTech FT5452 touchscreen (edt-ft5x06) with its
 *     GPIO62 power switch modelled as a fixed regulator;
 *   - nothing else was changed, so everything that used to work keeps
 *     working.
 *
 * The previous hand-written version of this file could not be built (it
 * referenced &sdhc2/&ufshci/&usb/&soc labels that do not exist) and, once
 * made buildable, produced a tree without working USB.  Keeping the proven
 * tree here is more useful than a pretty one that does not boot.
 *
 * Phandle values are numeric because the tree comes from a decompiled blob;
 * that is intentional and does not affect the result.
 */
/dts-v1/;

/ {
	compatible = "infinix,x676b", "mediatek,mt6789";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	model = "Infinix Note 12 Pro (X676B)";
	chassis-type = "handset";

	regulator-touch-vcc {
		compatible = "regulator-fixed";
		regulator-name = "touch-vcc";
		gpio = <0x0d 0x3e 0x00>;
		enable-active-high;
		regulator-always-on;
		phandle = <0x4e>;
	};

	clock-32k {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x7d00>;
		clock-output-names = "clk32k";
	};

	clock-13m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xc65d40>;
		clock-output-names = "clk13m";
	};

	clock-26m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x18cba80>;
		clock-output-names = "clk26m";
		phandle = <0x0e>;
	};

	clock-ulposc {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xf7f4900>;
		clock-output-names = "ulposc";
	};

	sound {
		compatible = "mediatek,mt6789-mt6366-sound";
		mediatek,platform = <0x12>;
		fs1559-extamp-gpios = <0x0d 0x96 0x00>;

		mediatek,speaker-codec {
		};
	};

	gps@18c00000 {
		compatible = "x676b,gps-stp";
		pinctrl-names = "default", "gps_l1_lna_disable", "gps_l1_lna_dsp_ctrl", "gps_l1_lna_enable";
		pinctrl-0 = <0x13>;
		pinctrl-1 = <0x15>;
		pinctrl-2 = <0x16>;
		pinctrl-3 = <0x17>;
		emi-region = <0x1d>;
		emi-offset = <0x400000>;
		emi-size = <0xfffff>;
		status = "okay";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x03>;
			cpu-supply = <0x18>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x04>;
			cpu-supply = <0x18>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x05>;
			cpu-supply = <0x18>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x06>;
			cpu-supply = <0x18>;
		};

		cpu@4 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x400>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x07>;
			cpu-supply = <0x18>;
		};

		cpu@5 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x500>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x08>;
			cpu-supply = <0x18>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x600>;
			performance-domains = <0x02 0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			phandle = <0x09>;
			cpu-supply = <0x19>;
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x700>;
			performance-domains = <0x02 0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			phandle = <0x0a>;
			cpu-supply = <0x19>;
		};
	};

	cpu-map {

		cluster0 {

			core0 {
				cpu = <0x03>;
			};

			core1 {
				cpu = <0x04>;
			};

			core2 {
				cpu = <0x05>;
			};

			core3 {
				cpu = <0x06>;
			};

			core4 {
				cpu = <0x07>;
			};

			core5 {
				cpu = <0x08>;
			};
		};

		cluster1 {

			core2 {
				cpu = <0x09>;
			};

			core3 {
				cpu = <0x0a>;
			};
		};
	};

	pmu-a55 {
		compatible = "arm,cortex-a55-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04 0x0b>;
	};

	pmu-a78 {
		compatible = "arm,cortex-a76-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04 0x0c>;
	};

	pmu-dsu {
		compatible = "arm,dsu-pmu";
		cpus = <0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a>;
		interrupts = <0x00 0x23 0x04 0x00>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	soc@0 {
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0x20000000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;

		performance-controller@11bc00 {
			compatible = "mediatek,cpufreq-hw";
			reg = <0x11bc10 0x120 0x11bd30 0x120>;
			#performance-domain-cells = <0x01>;
			phandle = <0x02>;
		};

		interrupt-controller@c000000 {
			compatible = "arm,gic-v3";
			reg = <0xc000000 0x40000 0xc040000 0x200000>;
			#interrupt-cells = <0x04>;
			interrupt-controller;
			interrupts = <0x01 0x09 0x04 0x0b>;
			phandle = <0x01>;

			ppi-partitions {

				interrupt-partition-0 {
					affinity = <0x03 0x04 0x05 0x06 0x07 0x08>;
					phandle = <0x0b>;
				};

				interrupt-partition-1 {
					affinity = <0x09 0x0a>;
					phandle = <0x0c>;
				};
			};
		};

		syscon@10000000 {
			compatible = "mediatek,mt6789-topckgen", "mediatek,mt8781-topckgen", "syscon";
			reg = <0x10000000 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x10>;
		};

		syscon@10001000 {
			compatible = "mediatek,mt6789-infracfg_ao", "mediatek,mt8781-infracfg_ao", "syscon";
			reg = <0x10001000 0x1000>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x11>;
		};

		syscon@1000c000 {
			compatible = "mediatek,mt6789-apmixedsys", "mediatek,mt8187-apmixedsys", "syscon";
			reg = <0x1000c000 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x24>;
		};

		syscon@10006000 {
			compatible = "mediatek,mt6789-scpsys", "syscon", "simple-mfd";
			reg = <0x10006000 0x1000>;

			power-controller {
				compatible = "mediatek,mt6789-power-controller";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				#power-domain-cells = <0x01>;
				phandle = <0x23>;

				power-domain@1 {
					reg = <0x01>;
					#power-domain-cells = <0x00>;
				};

				power-domain@2 {
					reg = <0x02>;
					clocks = <0x10 0x69 0x10 0x68>;
					clock-names = "mfg", "alt";
					domain-supply = <0x1a>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#power-domain-cells = <0x01>;

					power-domain@3 {
						reg = <0x03>;
						mediatek,infracfg = <0x11>;
						domain-supply = <0x1b>;
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						#power-domain-cells = <0x01>;

						power-domain@4 {
							reg = <0x04>;
							#power-domain-cells = <0x00>;
						};

						power-domain@5 {
							reg = <0x05>;
							#power-domain-cells = <0x00>;
						};
					};
				};

				power-domain@b {
					reg = <0x0b>;
					clocks = <0x10 0x76 0x11 0x25 0x11 0x20>;
					clock-names = "audio", "audio1", "audio2";
					mediatek,infracfg = <0x11>;
					#power-domain-cells = <0x00>;
				};

				power-domain@a {
					reg = <0x0a>;
					mediatek,infracfg = <0x11>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#power-domain-cells = <0x01>;

					power-domain@6 {
						reg = <0x06>;
						mediatek,infracfg = <0x11>;
						#power-domain-cells = <0x00>;
					};

					power-domain@c {
						reg = <0x0c>;
						mediatek,infracfg = <0x11>;
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						#power-domain-cells = <0x01>;
					};
				};
			};
		};

		syscon@10003000 {
			compatible = "mediatek,mt6789-pericfg-ao", "mediatek,mt8781-pericfg-ao", "syscon";
			reg = <0x10003000 0x1000>;
			#clock-cells = <0x01>;
		};

		pwrap@10026000 {
			compatible = "mediatek,mt6789-pwrap";
			reg = <0x10026000 0x1000>;
			reg-names = "pwrap";
			interrupts = <0x00 0xfc 0x04 0x00>;
			clocks = <0x11 0x01 0x11 0x00 0x10 0x4d>;
			clock-names = "spi", "wrap", "ulposc";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			mt6358 {
				compatible = "mediatek,mt6358";
				interrupt-parent = <0x0d>;
				interrupts = <0x89 0x04 0x89 0x00>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				phandle = <0x47>;

				mt6358regulator {
					compatible = "mediatek,mt6358-regulator";

					vcn28 {
						regulator-name = "vcn28";
						regulator-min-microvolt = <0x2ab980>;
						regulator-max-microvolt = <0x2ab980>;
						phandle = <0x4a>;
					};

					vcn33 {
						regulator-name = "vcn33";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x325aa0>;
						phandle = <0x4b>;
					};

					vmch {
						regulator-name = "vmch";
						regulator-min-microvolt = <0x2c4020>;
						regulator-max-microvolt = <0x325aa0>;
						phandle = <0x4c>;
					};

					vmc {
						regulator-name = "vmc";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x325aa0>;
						phandle = <0x4d>;
					};

					vcn18 {
						regulator-name = "vcn18";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						phandle = <0x49>;
					};

					vpa {
						regulator-name = "vpa";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x37b1d0>;
					};

					vgpu {
						regulator-name = "vgpu";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x13bdb6>;
						regulator-ramp-delay = <0x186a>;
						regulator-enable-ramp-delay = <0xc8>;
						regulator-allowed-modes = <0x00 0x01>;
						regulator-coupled-with = <0x1a>;
						regulator-coupled-max-spread = <0x186a0>;
						phandle = <0x1b>;
					};

					vsram-gpu {
						regulator-name = "vsram_gpu";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x13bdb6>;
						regulator-ramp-delay = <0x186a>;
						regulator-enable-ramp-delay = <0xf0>;
						regulator-coupled-with = <0x1b>;
						regulator-coupled-max-spread = <0x186a0>;
						phandle = <0x1a>;
					};

					vproc11 {
						regulator-name = "vproc11";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x13bdb6>;
						regulator-enable-ramp-delay = <0xc8>;
						regulator-always-on;
						regulator-allowed-modes = <0x00 0x01>;
						phandle = <0x19>;
					};

					vproc12 {
						regulator-name = "vproc12";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x13bdb6>;
						regulator-enable-ramp-delay = <0xc8>;
						regulator-always-on;
						regulator-allowed-modes = <0x00 0x01>;
						phandle = <0x18>;
					};

					vmodem: vmodem {
						regulator-name = "vmodem";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x13bdb6>;
					};
				};

				mt6358rtc {
					compatible = "mediatek,mt6358-rtc";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
				};

				mt6358keys {
					compatible = "mediatek,mt6358-keys";
				};

				mt6358-adc {
					compatible = "mediatek,mt6358-auxadc";
					#io-channel-cells = <0x01>;
				};

				battery {
					compatible = "mediatek,mt6358-battery";
					mediatek,charger = <0x1c>;
				};

				mt6358-sound {
					compatible = "mediatek,mt6358-sound";
					mediatek,dmic-mode = <0x00>;
				};
			};
		};

		efuse@11c10000 {
			compatible = "mediatek,efuse";
			reg = <0x11c10000 0x1000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			data1 {
				reg = <0x1b4 0x2c>;
				phandle = <0x1d>;
			};

			data2 {
				reg = <0x2f8 0x08>;
				phandle = <0x1e>;
			};
		};

		thermal-sensor@1100b000 {
			compatible = "mediatek,mt6789-lvts-ap";
			reg = <0x1100b000 0xc00>;
			interrupts = <0x00 0xc9 0x04 0x00>;
			clocks = <0x11 0x04>;
			clock-names = "lvts_clk";
			resets = <0x11 0x00>;
			nvmem-cells = <0x1d 0x1e>;
			nvmem-cell-names = "lvts-calib-data-1", "lvts-calib-data-2";
			#thermal-sensor-cells = <0x01>;
			phandle = <0x1f>;
		};

		thermal-zones {

			cpu_little1-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <0x1f 0x00>;

				trips {

					trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_little2-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <0x1f 0x01>;

				trips {

					trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_little3-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <0x1f 0x02>;

				trips {

					trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_little4-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <0x1f 0x03>;

				trips {

					trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_little5-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <0x1f 0x04>;

				trips {

					trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_little6-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <0x1f 0x05>;

				trips {

					trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_big1-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <0x1f 0x06>;

				trips {

					trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_big2-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <0x1f 0x07>;

				trips {

					trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			gpu0-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <0x1f 0x08>;

				trips {

					trip-alert {
						temperature = <0x14c08>;
						hysteresis = <0x7d0>;
						type = "passive";
						phandle = <0x20>;
					};

					trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};

				cooling-maps {

					map0 {
						trip = <0x20>;
						cooling-device = <0x21 0xffffffff 0xffffffff>;
					};
				};
			};

			gpu1-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <0x1f 0x09>;

				trips {

					trip-alert {
						temperature = <0x14c08>;
						hysteresis = <0x7d0>;
						type = "passive";
						phandle = <0x22>;
					};

					trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};

				cooling-maps {

					map0 {
						trip = <0x22>;
						cooling-device = <0x21 0xffffffff 0xffffffff>;
					};
				};
			};

			ts3_2-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <0x1f 0x0a>;

				trips {

					trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			ts3_3-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <0x1f 0x0b>;

				trips {

					trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			ts4_0-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <0x1f 0x0c>;

				trips {

					trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};
		};

		syscon@11210000 {
			compatible = "mediatek,mt6789-afe", "mediatek,mt8781-afe", "syscon";
			reg = <0x11210000 0x2000>;
			#clock-cells = <0x01>;
			power-domains = <0x23 0x0b>;
			phandle = <0x25>;

			audio-controller {
