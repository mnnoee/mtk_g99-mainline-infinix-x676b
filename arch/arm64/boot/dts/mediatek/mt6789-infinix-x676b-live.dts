				      "aud_general3_asrc",
				      "aud_connsys_i2s_asrc",
				      "aud_general1_asrc",
				      "aud_general2_asrc",
				      "aud_dac_hires_clk",
				      "aud_adc_hires_clk",
				      "aud_adc_hires_tml",
				      "aud_i2s1_bclk",
