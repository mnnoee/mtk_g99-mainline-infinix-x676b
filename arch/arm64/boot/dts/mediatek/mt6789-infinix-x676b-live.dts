/dts-v1/;

/ {
	compatible = "infinix,x676b", "mediatek,mt6789";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	model = "Infinix Note 12 Pro (X676B)";
	chassis-type = "handset";

	clock-32k {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x7d00>;
		clock-output-names = "clk32k";
	};

	clock-13m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xc65d40>;
		clock-output-names = "clk13m";
	};

	clock-26m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x18cba80>;
		clock-output-names = "clk26m";
		phandle = <0x0e>;
	};

	clock-ulposc {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xf7f4900>;
		clock-output-names = "ulposc";
	};

	sound: sound {
		compatible = "mediatek,mt6789-mt6366-sound";
		mediatek,platform = <&afe>;

		/* FS1559VN one-wire mode/enable line for the second
		 * (receiver / top) speaker amplifier, GPIO150.
		 */
		fs1559-extamp-gpios = <0x0d 0x96 0x00>;

		mediatek,speaker-codec {
		};
	};

	/*
	 * GPS/GNSS: STP transport + L1 LNA on GPIO25.  The vendor node is
	 * top-level (no reg); the driver only needs the pinctrl states.
	 * L5 LNA (GPIO26) is intentionally not used: that pin is the USB
	 * OTG VBUS switch on this board.
	 */
	gps: gps@18c00000 {
		compatible = "x676b,gps-stp";
		pinctrl-names = "default", "gps_l1_lna_disable",
				"gps_l1_lna_dsp_ctrl", "gps_l1_lna_enable";
		pinctrl-0 = <&gps_pins_default>;
		pinctrl-1 = <&gps_l1_lna_pins_ol>;
		pinctrl-2 = <&gps_l1_lna_pins_dsp_ctrl>;
		pinctrl-3 = <&gps_l1_lna_pins_oh>;
		emi-region = <29>;
		emi-offset = <0x400000>;
		emi-size = <0xfffff>;
		status = "okay";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x03>;			cpu-supply = <&mt6358_vproc12_reg>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x04>;			cpu-supply = <&mt6358_vproc12_reg>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x05>;			cpu-supply = <&mt6358_vproc12_reg>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x06>;			cpu-supply = <&mt6358_vproc12_reg>;
		};

		cpu@4 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x400>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x07>;			cpu-supply = <&mt6358_vproc12_reg>;
		};

		cpu@5 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x500>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x08>;			cpu-supply = <&mt6358_vproc12_reg>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x600>;
			performance-domains = <0x02 0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			phandle = <0x09>;			cpu-supply = <&mt6358_vproc11_reg>;
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x700>;
			performance-domains = <0x02 0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			phandle = <0x0a>;			cpu-supply = <&mt6358_vproc11_reg>;
		};
	};

	cpu-map {

		cluster0 {

			core0 {
				cpu = <0x03>;
			};

			core1 {
				cpu = <0x04>;
			};

			core2 {
				cpu = <0x05>;
			};

			core3 {
				cpu = <0x06>;
			};

			core4 {
				cpu = <0x07>;
			};

			core5 {
				cpu = <0x08>;
			};
		};

		cluster1 {

			core2 {
				cpu = <0x09>;
			};

			core3 {
				cpu = <0x0a>;
			};
		};
	};

	pmu-a55 {
		compatible = "arm,cortex-a55-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04 0x0b>;
	};

	pmu-a78 {
		compatible = "arm,cortex-a76-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04 0x0c>;
	};

	pmu-dsu {
		compatible = "arm,dsu-pmu";
		cpus = <0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a>;
		interrupts = <0x00 0x23 0x04 0x00>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	soc@0 {
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0x20000000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;

		performance-controller@11bc00 {
			compatible = "mediatek,cpufreq-hw";
			reg = <0x11bc10 0x120 0x11bd30 0x120>;
			#performance-domain-cells = <0x01>;
			phandle = <0x02>;
		};

		interrupt-controller@c000000 {
			compatible = "arm,gic-v3";
			reg = <0xc000000 0x40000 0xc040000 0x200000>;
			#interrupt-cells = <0x04>;
			interrupt-controller;
			interrupts = <0x01 0x09 0x04 0x0b>;
			phandle = <0x01>;

			ppi-partitions {

				interrupt-partition-0 {
					affinity = <0x03 0x04 0x05 0x06 0x07 0x08>;
					phandle = <0x0b>;
				};

				interrupt-partition-1 {
					affinity = <0x09 0x0a>;
					phandle = <0x0c>;
				};
			};
		};

		syscon@10000000 {
			compatible = "mediatek,mt6789-topckgen", "mediatek,mt8781-topckgen", "syscon";
			reg = <0x10000000 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x10>;
		};

		syscon@10001000 {
			compatible = "mediatek,mt6789-infracfg_ao", "mediatek,mt8781-infracfg_ao", "syscon";
			reg = <0x10001000 0x1000>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x11>;

		};

		apmixedsys: syscon@1000c000 {
			compatible = "mediatek,mt6789-apmixedsys", "mediatek,mt8187-apmixedsys", "syscon";
			reg = <0x1000c000 0x1000>;
			#clock-cells = <0x01>;
		};

		scpsys: syscon@10006000 {
			compatible = "mediatek,mt6789-scpsys", "syscon", "simple-mfd";
			reg = <0x10006000 0x1000>;

			spm: power-controller {
				compatible = "mediatek,mt6789-power-controller";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				#power-domain-cells = <0x01>;

				/* CONN MTCMOS: needed by the CONSYS/Wi-Fi block */
				power-domain@1 {
					reg = <0x01>;
					#power-domain-cells = <0x00>;
				};

				/* GPU MFG hierarchy: MFG0 -> MFG1 -> MFG2/MFG3 */
				mfg0: power-domain@2 {
					reg = <0x02>;
					clocks = <0x10 105>, <0x10 104>;
					clock-names = "mfg", "alt";
					domain-supply = <&mt6358_vsram_gpu_reg>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#power-domain-cells = <0x01>;

					mfg1: power-domain@3 {
						reg = <0x03>;
						mediatek,infracfg = <0x11>;
						domain-supply = <&mt6358_vgpu_reg>;
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						#power-domain-cells = <0x01>;

						power-domain@4 {
							reg = <0x04>;
							#power-domain-cells = <0x00>;
						};

						power-domain@5 {
							reg = <0x05>;
							#power-domain-cells = <0x00>;
						};
					};
				};

				power-domain@b {
					reg = <0x0b>;
					clocks = <0x10 118>, <0x11 37>, <0x11 32>;
					clock-names = "audio", "audio1", "audio2";
					mediatek,infracfg = <0x11>;
					#power-domain-cells = <0x00>;
				};

				/* DISP MTCMOS: needed by the display pipeline.
				 * No clocks here on purpose: the mm clock gates are
				 * handled by the mmsys driver, and we boot with
				 * clk_ignore_unused/pd_ignore_unused.
				 */
				disp: power-domain@a {
					reg = <0x0a>;
					#power-domain-cells = <0x00>;
				};
			};
		};

		syscon@10003000 {
			compatible = "mediatek,mt6789-pericfg-ao", "mediatek,mt8781-pericfg-ao", "syscon";
			reg = <0x10003000 0x1000>;
			#clock-cells = <0x01>;
		};

		/* PMIC bridge (SPI-like) + MT6366 (called mt6358 in mainline).
		 * Provides the regulators, RTC and the base for charger/battery.
		 * Clocks: infra_ao PMIC_AP(1)/PMIC_TMR(0), topckgen PWRAP_ULPOSC(0x4d).
		 * IRQ: GIC SPI 252; the PMIC IRQ arrives through the pinctrl EINT
		 * (0x0d), pin 137.
		 */
		pwrap: pwrap@10026000 {
			compatible = "mediatek,mt6789-pwrap";
			reg = <0x10026000 0x1000>;
			reg-names = "pwrap";
			interrupts = <0x00 0xfc 0x04 0x00>;
			clocks = <0x11 0x01 0x11 0x00 0x10 0x4d>;
			clock-names = "spi", "wrap", "ulposc";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			pmic: mt6358 {
				compatible = "mediatek,mt6358";
				interrupt-parent = <0x0d>;
				interrupts = <0x89 0x04 0x89 0x00>;
				interrupt-controller;
				#interrupt-cells = <0x02>;

				mt6358regulator: mt6358regulator {
					compatible = "mediatek,mt6358-regulator";

					/* SD card: VDD (VMCH) and VccQ (VMC) come from the
					 * PMIC, not from fixed regulators.
					 */
					/* supplies requested by the MT6789 consys driver */
					vcn28: vcn28 {
						regulator-name = "vcn28";
						regulator-min-microvolt = <2800000>;
						regulator-max-microvolt = <2800000>;
					};

					vcn33: vcn33 {
						regulator-name = "vcn33";
						regulator-min-microvolt = <1800000>;
						regulator-max-microvolt = <3300000>;
					};

					mt6358_vmch_reg: vmch {
						regulator-name = "vmch";
						regulator-min-microvolt = <2900000>;
						regulator-max-microvolt = <3300000>;
					};

					mt6358_vmc_reg: vmc {
						regulator-name = "vmc";
						regulator-min-microvolt = <1800000>;
						regulator-max-microvolt = <3300000>;
					};

					vcn18: vcn18 {
						regulator-name = "vcn18";
						regulator-min-microvolt = <1800000>;
						regulator-max-microvolt = <1800000>;
					};

					vpa: vpa {
						regulator-name = "vpa";
						regulator-min-microvolt = <500000>;
						regulator-max-microvolt = <3650000>;
					};

					/* GPU rails: MT6366 buck_vgpu + ldo_vsram_gpu (coupled) */
					mt6358_vgpu_reg: vgpu {
						regulator-name = "vgpu";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x13bdb6>;
						regulator-ramp-delay = <0x186a>;
						regulator-enable-ramp-delay = <0xc8>;
						regulator-allowed-modes = <0x00 0x01>;
						regulator-coupled-with = <&mt6358_vsram_gpu_reg>;
						regulator-coupled-max-spread = <0x186a0>;
					};

					mt6358_vsram_gpu_reg: vsram-gpu {
						regulator-name = "vsram_gpu";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x13bdb6>;
						regulator-ramp-delay = <0x186a>;
						regulator-enable-ramp-delay = <0xf0>;
						regulator-coupled-with = <&mt6358_vgpu_reg>;
						regulator-coupled-max-spread = <0x186a0>;
					};

					mt6358_vproc11_reg: vproc11 {
						regulator-name = "vproc11";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x13bdb6>;
						regulator-enable-ramp-delay = <0xc8>;
						regulator-always-on;
						regulator-allowed-modes = <0x00 0x01>;
					};

					mt6358_vproc12_reg: vproc12 {
						regulator-name = "vproc12";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x13bdb6>;
						regulator-enable-ramp-delay = <0xc8>;
						regulator-always-on;
						regulator-allowed-modes = <0x00 0x01>;
					};
				};

				mt6358rtc: mt6358rtc {
					compatible = "mediatek,mt6358-rtc";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
				};

				mt6358keys: mt6358keys {
					compatible = "mediatek,mt6358-keys";
				};

				mt6358adc: mt6358-adc {
					compatible = "mediatek,mt6358-auxadc";
					#io-channel-cells = <0x01>;
				};

				mt6358bat: battery {
					compatible = "mediatek,mt6358-battery";
					mediatek,charger = <&rt9471_chg>;
				};

				mt6358sound: mt6358-sound {
					compatible = "mediatek,mt6358-sound";
					mediatek,dmic-mode = <0x00>;
				};
			};
		};

		/* efuse (nvmem) — used for LVTS calibration */
		efuse: efuse@11c10000 {
			compatible = "mediatek,efuse";
			reg = <0x11c10000 0x1000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			lvts_e_data1: data1 {
				reg = <0x1b4 0x2c>;
			};

			lvts_e_data2: data2 {
				reg = <0x2f8 0x08>;
			};
		};

		/* SoC thermal sensors. There is no mt6789 support in mainline yet, so use
		 * mt8192 (same block at 0x1100b000).
		 */
		lvts: thermal-sensor@1100b000 {
			compatible = "mediatek,mt6789-lvts-ap";
			reg = <0x1100b000 0xc00>;
			interrupts = <0x00 0xc9 0x04 0x00>;
			clocks = <0x11 0x04>;
			clock-names = "lvts_clk";
			resets = <0x11 0x00>;
			nvmem-cells = <&lvts_e_data1>, <&lvts_e_data2>;
			nvmem-cell-names = "lvts-calib-data-1", "lvts-calib-data-2";
			#thermal-sensor-cells = <0x01>;
		};

		thermal-zones {
			cpu_little1-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 0>;

				trips {
					cpu_little1_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_little2-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 1>;

				trips {
					cpu_little2_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_little3-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 2>;

				trips {
					cpu_little3_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_little4-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 3>;

				trips {
					cpu_little4_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_little5-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 4>;

				trips {
					cpu_little5_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_little6-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 5>;

				trips {
					cpu_little6_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_big1-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 6>;

				trips {
					cpu_big1_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_big2-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 7>;

				trips {
					cpu_big2_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			gpu0-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 8>;

				trips {
					gpu0_alert: trip-alert {
						temperature = <0x14c08>;
						hysteresis = <0x7d0>;
						type = "passive";
					};

					gpu0_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};

				cooling-maps {
					map0 {
						trip = <&gpu0_alert>;
						cooling-device = <&gpu 0xffffffff 0xffffffff>;
					};
				};
			};

			gpu1-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 9>;

				trips {
					gpu1_alert: trip-alert {
						temperature = <0x14c08>;
						hysteresis = <0x7d0>;
						type = "passive";
					};

					gpu1_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};

				cooling-maps {
					map0 {
						trip = <&gpu1_alert>;
						cooling-device = <&gpu 0xffffffff 0xffffffff>;
					};
				};
			};

			ts3_2-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 10>;

				trips {
					ts3_2_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			ts3_3-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 11>;

				trips {
					ts3_3_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			ts4_0-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 12>;

				trips {
					ts4_0_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

		};

		audsys: syscon@11210000 {
			compatible = "mediatek,mt6789-afe", "mediatek,mt8781-afe", "syscon";
			reg = <0x11210000 0x2000>;
			#clock-cells = <0x01>;
			power-domains = <&spm 0x0b>;

			afe: audio-controller {
				compatible = "mediatek,mt6789-sound";
				interrupts = <0x00 0xea 0x04 0x00>;
				topckgen = <0x10>;
				apmixedsys = <&apmixedsys>;
				infracfg = <0x11>;
				clocks = 
				<&audsys 0>,
				<&audsys 6>,
				<&audsys 7>,
