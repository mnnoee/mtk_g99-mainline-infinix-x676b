/dts-v1/;

/ {
	compatible = "infinix,x676b", "mediatek,mt6789";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	model = "Infinix Note 12 Pro (X676B)";
	chassis-type = "handset";

	clock-32k {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x7d00>;
		clock-output-names = "clk32k";
	};

	clock-13m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xc65d40>;
		clock-output-names = "clk13m";
	};

	clock-26m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x18cba80>;
		clock-output-names = "clk26m";
		phandle = <0x0e>;
	};

	clock-ulposc {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xf7f4900>;
		clock-output-names = "ulposc";
	};

	sound: sound {
		compatible = "mediatek,mt6789-mt6366-sound";
		mediatek,platform = <&afe>;

		mediatek,speaker-codec {
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x03>;			cpu-supply = <&mt6358_vproc12_reg>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x04>;			cpu-supply = <&mt6358_vproc12_reg>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x05>;			cpu-supply = <&mt6358_vproc12_reg>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x06>;			cpu-supply = <&mt6358_vproc12_reg>;
		};

		cpu@4 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x400>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x07>;			cpu-supply = <&mt6358_vproc12_reg>;
		};

		cpu@5 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x500>;
			performance-domains = <0x02 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x17f>;
			phandle = <0x08>;			cpu-supply = <&mt6358_vproc12_reg>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x600>;
			performance-domains = <0x02 0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			phandle = <0x09>;			cpu-supply = <&mt6358_vproc11_reg>;
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x700>;
			performance-domains = <0x02 0x01>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			phandle = <0x0a>;			cpu-supply = <&mt6358_vproc11_reg>;
		};
	};

	cpu-map {

		cluster0 {

			core0 {
				cpu = <0x03>;
			};

			core1 {
				cpu = <0x04>;
			};

			core2 {
				cpu = <0x05>;
			};

			core3 {
				cpu = <0x06>;
			};

			core4 {
				cpu = <0x07>;
			};

			core5 {
				cpu = <0x08>;
			};
		};

		cluster1 {

			core2 {
				cpu = <0x09>;
			};

			core3 {
				cpu = <0x0a>;
			};
		};
	};

	pmu-a55 {
		compatible = "arm,cortex-a55-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04 0x0b>;
	};

	pmu-a78 {
		compatible = "arm,cortex-a76-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04 0x0c>;
	};

	pmu-dsu {
		compatible = "arm,dsu-pmu";
		cpus = <0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a>;
		interrupts = <0x00 0x23 0x04 0x00>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	soc@0 {
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0x20000000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;

		performance-controller@11bc00 {
			compatible = "mediatek,cpufreq-hw";
			reg = <0x11bc10 0x120 0x11bd30 0x120>;
			#performance-domain-cells = <0x01>;
			phandle = <0x02>;
		};

		interrupt-controller@c000000 {
			compatible = "arm,gic-v3";
			reg = <0xc000000 0x40000 0xc040000 0x200000>;
			#interrupt-cells = <0x04>;
			interrupt-controller;
			interrupts = <0x01 0x09 0x04 0x0b>;
			phandle = <0x01>;

			ppi-partitions {

				interrupt-partition-0 {
					affinity = <0x03 0x04 0x05 0x06 0x07 0x08>;
					phandle = <0x0b>;
				};

				interrupt-partition-1 {
					affinity = <0x09 0x0a>;
					phandle = <0x0c>;
				};
			};
		};

		syscon@10000000 {
			compatible = "mediatek,mt6789-topckgen", "mediatek,mt8781-topckgen", "syscon";
			reg = <0x10000000 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x10>;
		};

		syscon@10001000 {
			compatible = "mediatek,mt6789-infracfg_ao", "mediatek,mt8781-infracfg_ao", "syscon";
			reg = <0x10001000 0x1000>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x11>;

		};

		apmixedsys: syscon@1000c000 {
			compatible = "mediatek,mt6789-apmixedsys", "mediatek,mt8187-apmixedsys", "syscon";
			reg = <0x1000c000 0x1000>;
			#clock-cells = <0x01>;
		};

		scpsys: syscon@10006000 {
			compatible = "mediatek,mt6789-scpsys", "syscon", "simple-mfd";
			reg = <0x10006000 0x1000>;

			spm: power-controller {
				compatible = "mediatek,mt6789-power-controller";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				#power-domain-cells = <0x01>;

				power-domain@b {
					reg = <0x0b>;
					clocks = <0x10 118>, <0x11 37>, <0x11 32>;
					clock-names = "audio", "audio1", "audio2";
					mediatek,infracfg = <0x11>;
					#power-domain-cells = <0x00>;
				};
			};
		};

		syscon@10003000 {
			compatible = "mediatek,mt6789-pericfg-ao", "mediatek,mt8781-pericfg-ao", "syscon";
			reg = <0x10003000 0x1000>;
			#clock-cells = <0x01>;
		};

		/* PMIC bridge (SPI-like) + MT6366 (called mt6358 in mainline).
		 * Provides the regulators, RTC and the base for charger/battery.
		 * Clocks: infra_ao PMIC_AP(1)/PMIC_TMR(0), topckgen PWRAP_ULPOSC(0x4d).
		 * IRQ: GIC SPI 252; the PMIC IRQ arrives through the pinctrl EINT
		 * (0x0d), pin 137.
		 */
		pwrap: pwrap@10026000 {
			compatible = "mediatek,mt6789-pwrap";
			reg = <0x10026000 0x1000>;
			reg-names = "pwrap";
			interrupts = <0x00 0xfc 0x04 0x00>;
			clocks = <0x11 0x01 0x11 0x00 0x10 0x4d>;
			clock-names = "spi", "wrap", "ulposc";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			pmic: mt6358 {
				compatible = "mediatek,mt6358";
				interrupt-parent = <0x0d>;
				interrupts = <0x89 0x04 0x89 0x00>;
				interrupt-controller;
				#interrupt-cells = <0x02>;

				mt6358regulator: mt6358regulator {
					compatible = "mediatek,mt6358-regulator";

					/* SD card: VDD (VMCH) and VccQ (VMC) come from the
					 * PMIC, not from fixed regulators.
					 */
					mt6358_vmch_reg: vmch {
						regulator-name = "vmch";
						regulator-min-microvolt = <2900000>;
						regulator-max-microvolt = <3300000>;
					};

					mt6358_vmc_reg: vmc {
						regulator-name = "vmc";
						regulator-min-microvolt = <1800000>;
						regulator-max-microvolt = <3300000>;
					};

					vcn18: vcn18 {
						regulator-name = "vcn18";
						regulator-min-microvolt = <1800000>;
						regulator-max-microvolt = <1800000>;
					};

					vpa: vpa {
						regulator-name = "vpa";
						regulator-min-microvolt = <500000>;
						regulator-max-microvolt = <3650000>;
					};

					mt6358_vproc11_reg: vproc11 {
						regulator-name = "vproc11";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x13bdb6>;
						regulator-enable-ramp-delay = <0xc8>;
						regulator-always-on;
						regulator-allowed-modes = <0x00 0x01>;
					};

					mt6358_vproc12_reg: vproc12 {
						regulator-name = "vproc12";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x13bdb6>;
						regulator-enable-ramp-delay = <0xc8>;
						regulator-always-on;
						regulator-allowed-modes = <0x00 0x01>;
					};
				};

				mt6358rtc: mt6358rtc {
					compatible = "mediatek,mt6358-rtc";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
				};

				mt6358keys: mt6358keys {
					compatible = "mediatek,mt6358-keys";
				};

				mt6358adc: mt6358-adc {
					compatible = "mediatek,mt6358-auxadc";
					#io-channel-cells = <0x01>;
				};

				mt6358bat: battery {
					compatible = "mediatek,mt6358-battery";
					mediatek,charger = <&rt9471_chg>;
				};

				mt6358sound: mt6358-sound {
					compatible = "mediatek,mt6358-sound";
					mediatek,dmic-mode = <0x00>;
				};
			};
		};

		/* efuse (nvmem) — used for LVTS calibration */
		efuse: efuse@11c10000 {
			compatible = "mediatek,efuse";
			reg = <0x11c10000 0x1000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			lvts_e_data1: data1 {
				reg = <0x1b4 0x2c>;
			};

			lvts_e_data2: data2 {
				reg = <0x2f8 0x08>;
			};
		};

		/* SoC thermal sensors. There is no mt6789 support in mainline yet, so use
		 * mt8192 (same block at 0x1100b000).
		 */
		lvts: thermal-sensor@1100b000 {
			compatible = "mediatek,mt6789-lvts-ap";
			reg = <0x1100b000 0xc00>;
			interrupts = <0x00 0xc9 0x04 0x00>;
			clocks = <0x11 0x04>;
			clock-names = "lvts_clk";
			resets = <0x11 0x00>;
			nvmem-cells = <&lvts_e_data1>, <&lvts_e_data2>;
			nvmem-cell-names = "lvts-calib-data-1", "lvts-calib-data-2";
			#thermal-sensor-cells = <0x01>;
		};

		thermal-zones {
			cpu_little1-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 0>;

				trips {
					cpu_little1_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_little2-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 1>;

				trips {
					cpu_little2_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_little3-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 2>;

				trips {
					cpu_little3_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_little4-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 3>;

				trips {
					cpu_little4_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_little5-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 4>;

				trips {
					cpu_little5_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_little6-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 5>;

				trips {
					cpu_little6_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_big1-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 6>;

				trips {
					cpu_big1_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			cpu_big2-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 7>;

				trips {
					cpu_big2_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			gpu0-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 8>;

				trips {
					gpu0_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			gpu1-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 9>;

				trips {
					gpu1_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			ts3_2-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 10>;

				trips {
					ts3_2_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			ts3_3-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 11>;

				trips {
					ts3_3_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

			ts4_0-thermal {
				polling-delay = <0x3e8>;
				polling-delay-passive = <0xfa>;
				thermal-sensors = <&lvts 12>;

				trips {
					ts4_0_crit: trip-crit {
						temperature = <0x1adb0>;
						hysteresis = <0x7d0>;
						type = "critical";
					};
				};
			};

		};

		audsys: syscon@11210000 {
			compatible = "mediatek,mt6789-afe", "mediatek,mt8781-afe", "syscon";
			reg = <0x11210000 0x2000>;
			#clock-cells = <0x01>;
			power-domains = <&spm 0x0b>;

			afe: audio-controller {
				compatible = "mediatek,mt6789-sound";
				interrupts = <0x00 0xea 0x04 0x00>;
				topckgen = <0x10>;
				apmixedsys = <&apmixedsys>;
				infracfg = <0x11>;
				clocks = 
				<&audsys 0>,
				<&audsys 6>,
				<&audsys 7>,
				<&audsys 5>,
				<&audsys 1>,
				<&audsys 2>,
				<&audsys 4>,
				<&audsys 3>,
				<&audsys 8>,
				<&audsys 9>,
				<0x11 32>,
				<0x11 37>,
				<&audsys 14>,
				<&audsys 15>,
				<&audsys 16>,
				<&audsys 17>,
				<&audsys 18>,
				<&audsys 19>,
				<&audsys 20>,
				<&audsys 10>,
				<&audsys 11>,
				<&audsys 12>,
				<&audsys 13>,
				<&apmixedsys 11>,
				<&apmixedsys 12>,
				<0x10 117>,
				<0x10 118>,
				<0x10 3>,
				<0x10 135>,
				<0x10 36>,
				<0x10 136>,
				<0x10 94>,
				<0x10 131>,
				<0x10 38>,
				<0x10 39>,
				<0x10 132>,
				<0x10 41>,
				<0x10 42>,
				<0x10 148>,
				<0x10 149>,
				<0x10 150>,
				<0x10 151>,
				<0x10 158>,
				<0x10 159>,
				<0x10 160>,
				<0x10 161>,
				<0x10 162>,
				<0x10 163>,
				<0x10 164>,
				<0x10 142>,
				<0x10 55>;
				pinctrl-names = "aud_clk_mosi_off", "aud_clk_mosi_on",
						"aud_clk_miso_off", "aud_clk_miso_on",
						"aud_dat_mosi_off", "aud_dat_mosi_on",
						"aud_dat_miso0_off", "aud_dat_miso0_on",
						"aud_dat_miso1_off", "aud_dat_miso1_on",
						"aud_gpio_i2s0_off", "aud_gpio_i2s0_on",
						"aud_gpio_i2s3_off", "aud_gpio_i2s3_on",
						"vow_dat_miso_off", "vow_dat_miso_on",
						"vow_clk_miso_off", "vow_clk_miso_on";
				pinctrl-0 = <&aud_clk_mosi_off>;
				pinctrl-1 = <&aud_clk_mosi_on>;
				pinctrl-2 = <&aud_clk_miso_off>;
				pinctrl-3 = <&aud_clk_miso_on>;
				pinctrl-4 = <&aud_dat_mosi_off>;
				pinctrl-5 = <&aud_dat_mosi_on>;
				pinctrl-6 = <&aud_dat_miso0_off>;
				pinctrl-7 = <&aud_dat_miso0_on>;
				pinctrl-8 = <&aud_dat_miso1_off>;
				pinctrl-9 = <&aud_dat_miso1_on>;
				pinctrl-10 = <&aud_gpio_i2s0_off>;
				pinctrl-11 = <&aud_gpio_i2s0_on>;
				pinctrl-12 = <&aud_gpio_i2s3_off>;
				pinctrl-13 = <&aud_gpio_i2s3_on>;
				pinctrl-14 = <&vow_dat_miso_off>;
				pinctrl-15 = <&vow_dat_miso_on>;
				pinctrl-16 = <&vow_clk_miso_off>;
				pinctrl-17 = <&vow_clk_miso_on>;
				clock-names = 
				      "aud_afe_clk",
				      "aud_dac_clk",
				      "aud_dac_predis_clk",
				      "aud_adc_clk",
				      "aud_apll22m_clk",
				      "aud_apll24m_clk",
				      "aud_apll1_tuner_clk",
				      "aud_apll2_tuner_clk",
				      "aud_tml_clk",
				      "aud_nle",
				      "aud_infra_clk",
				      "aud_infra_26m_clk",
				      "aud_general3_asrc",
				      "aud_connsys_i2s_asrc",
				      "aud_general1_asrc",
				      "aud_general2_asrc",
				      "aud_dac_hires_clk",
				      "aud_adc_hires_clk",
				      "aud_adc_hires_tml",
				      "aud_i2s1_bclk",
				      "aud_i2s2_bclk",
				      "aud_i2s3_bclk",
				      "aud_i2s4_bclk",
				      "aud_clk_apmixed_apll1",
				      "aud_clk_apmixed_apll2",
				      "top_mux_audio",
				      "top_mux_audio_int",
				      "top_mainpll_d4_d4",
				      "top_mux_aud_1",
				      "top_apll1_ck",
				      "top_mux_aud_2",
				      "top_apll2_ck",
				      "top_mux_aud_eng1",
				      "top_apll1_d4",
				      "top_apll1_d8",
				      "top_mux_aud_eng2",
				      "top_apll2_d4",
				      "top_apll2_d8",
				      "top_i2s0_m_sel",
				      "top_i2s1_m_sel",
				      "top_i2s2_m_sel",
				      "top_i2s3_m_sel",
				      "top_apll12_div0",
				      "top_apll12_div1",
				      "top_apll12_div2",
				      "top_apll12_div3",
				      "top_apll12_div4",
				      "top_apll12_divb",
				      "top_apll12_div5",
				      "top_mux_audio_h",
				      "top_clk26m_clk";
			};
		};

		syscon@13fbf000 {
			compatible = "mediatek,mt6789-mfg", "mediatek,mt8781-mfg", "syscon";
			reg = <0x13fbf000 0x1000>;
			#clock-cells = <0x01>;
		};

		syscon@14000000 {
			compatible = "mediatek,mt6789-mmsys", "mediatek,mt8781-mmsys", "syscon";
			reg = <0x14000000 0x1000>;
			#clock-cells = <0x01>;
		};

		syscon@1101b000 {
			compatible = "mediatek,mt6789-imp-iic-wrap-c", "syscon";
			phandle = <0x30>;
			reg = <0x1101b000 0x1000>;
			#clock-cells = <0x01>;
		};

		syscon@11e02000 {
			compatible = "mediatek,mt6789-imp-iic-wrap-w", "syscon";
			phandle = <0x31>;
			reg = <0x11e02000 0x1000>;
			#clock-cells = <0x01>;
		};

		syscon@11eb4000 {
			compatible = "mediatek,mt6789-imp-iic-wrap-en", "syscon";
			phandle = <0x32>;
			reg = <0x11eb4000 0x1000>;
			#clock-cells = <0x01>;
		};

		syscon@11f01000 {
			compatible = "mediatek,mt6789-imp-iic-wrap-n", "syscon";
			phandle = <0x33>;
			reg = <0x11f01000 0x1000>;
			#clock-cells = <0x01>;
		};

		pinctrl {
			compatible = "mediatek,mt6789-pinctrl", "mediatek,mt8781-pinctrl";
			reg = <0x10005000 0x1000 0x11c30000 0x1000 0x11d10000 0x1000 0x11d40000 0x1000 0x11e20000 0x1000 0x11e60000 0x1000 0x11ea0000 0x1000 0x1000b000 0x1000>;
			reg-names = "iocfg0", "iocfg_rb", "iocfg_bm", "iocfg_br", "iocfg_lm", "iocfg_bl", "iocfg_rt", "eint";
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x0d 0x00 0x00 0xbc>;

			interrupt-controller;
			#interrupt-cells = <0x02>;
			/* EINT summary IRQ: GIC SPI 244 (stock eint node
			 * apirq@1000b000 uses <0 0xf4 4 0>); registers and
			 * reg-names already include the "eint" region.
			 */
			interrupts = <0x00 0xf4 0x04 0x00>;
			phandle = <0x0d>;

			/* GPIO12 powers the gate IC that feeds the speaker
			 * amplifier (stock DT: gate-power-gpios = <&pio 12 0>).
			 * Without it the speaker amp stays unpowered.
			 */
			gate_ic_power: gate-ic-power {
				gpio-hog;
				gpios = <0x0c 0x00>;
				output-high;
				line-name = "gate-ic-power";
			};

			/* GPIO153 enables the speaker amplifier (stock overlay:
			 * fs1559_dual_speaker_gpio = <&pio 153 0>). It is
			 * required in addition to the gate IC power above.
			 */
			spk_amp_enable: spk-amp-enable {
				gpio-hog;
				gpios = <0x99 0x00>;
				output-high;
				line-name = "spk-amp-enable";
			};
					mmc1-pins {
				phandle = <0x14>;

				pins-cmd-dat {
					pinmux = <0x4901 0x4a01 0x4b01 0x4c01 0x4801>;
					input-enable;
					/* MT6789 drive steps are 2/4 mA: 3 mA is
					 * rejected and would abort the whole group,
					 * leaving the lines without pull-ups.
					 */
					drive-strength = <0x04>;
					bias-pull-up = <0x65>;
					};

				pins-clk {
					pinmux = <0x4701>;
					drive-strength = <0x04>;
					bias-pull-down = <0x66>;
					};
			};



			aud_clk_mosi_off: aud_clk_mosi_off {

				pins_cmd0_dat {
					pinmux = <0xa900>;
					input-enable;
					bias-pull-down;
				};
			};

			aud_clk_mosi_on: aud_clk_mosi_on {

				pins_cmd0_dat {
					pinmux = <0xa901>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			aud_clk_miso_off: aud_clk_miso_off {

				pins_cmd0_dat {
					pinmux = <0xad00>;
					input-enable;
					bias-pull-down;
				};
			};

			aud_clk_miso_on: aud_clk_miso_on {

				pins_cmd0_dat {
					pinmux = <0xad01>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			aud_dat_mosi_off: aud_dat_mosi_off {

				pins_cmd0_dat {
					pinmux = <0xab00>;
					input-enable;
					bias-pull-down;
				};

				pins_cmd1_dat {
					pinmux = <0xac00>;
					input-enable;
					bias-pull-down;
				};
			};

			aud_dat_mosi_on: aud_dat_mosi_on {

				pins_cmd0_dat {
					pinmux = <0xab01>;
					input-schmitt-enable;
					bias-disable;
				};

				pins_cmd1_dat {
					pinmux = <0xac01>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			aud_dat_miso0_off: aud_dat_miso0_off {

				pins_cmd1_dat {
					pinmux = <0xaf00>;
					input-enable;
					bias-pull-down;
				};
			};

			aud_dat_miso0_on: aud_dat_miso0_on {

				pins_cmd1_dat {
					pinmux = <0xaf01>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			aud_dat_miso1_off: aud_dat_miso1_off {

				pins_cmd1_dat {
					pinmux = <0xb000>;
					input-enable;
					bias-disable;
				};
			};

			aud_dat_miso1_on: aud_dat_miso1_on {

				pins_cmd1_dat {
					pinmux = <0xb001>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			aud_gpio_i2s0_off: aud_gpio_i2s0_off {

				pins_cmd1_dat {
					pinmux = <0x3500>;
					input-enable;
					bias-pull-down;
				};
			};

			aud_gpio_i2s0_on: aud_gpio_i2s0_on {

				pins_cmd1_dat {
					pinmux = <0x3502>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			aud_gpio_i2s3_off: aud_gpio_i2s3_off {

				pins_cmd1_dat {
					pinmux = <0x3200>;
					input-enable;
					bias-pull-down;
				};

				pins_cmd2_dat {
					pinmux = <0x3300>;
					input-enable;
					bias-pull-down;
				};

				pins_cmd3_dat {
					pinmux = <0x3400>;
					input-enable;
					bias-pull-down;
				};
			};

			aud_gpio_i2s3_on: aud_gpio_i2s3_on {

				pins_cmd1_dat {
					pinmux = <0x3202>;
					input-schmitt-enable;
					bias-disable;
				};

				pins_cmd2_dat {
					pinmux = <0x3302>;
					input-schmitt-enable;
					bias-disable;
				};

				pins_cmd3_dat {
					pinmux = <0x3402>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			vow_dat_miso_off: vow_dat_miso_off {

				pins_cmd1_dat {
					pinmux = <0xaf00>;
					input-enable;
					bias-pull-down;
				};
			};

			vow_dat_miso_on: vow_dat_miso_on {

				pins_cmd1_dat {
					pinmux = <0xaf04>;
					input-schmitt-enable;
					bias-disable;
				};
			};

			vow_clk_miso_off: vow_clk_miso_off {

				pins_cmd1_dat {
					pinmux = <0xb000>;
					input-enable;
					bias-pull-down;
				};
			};

			vow_clk_miso_on: vow_clk_miso_on {

				pins_cmd1_dat {
					pinmux = <0xb004>;
					input-schmitt-enable;
					bias-disable;
				};
			};
};

		serial@11002000 {
			compatible = "mediatek,mt6577-uart";
			reg = <0x11002000 0x1000>;
			interrupts = <0x00 0x8d 0x04 0x00>;
			clocks = <0x0e 0x0e>;
			clock-names = "baud", "bus";
			status = "okay";
		};

		serial@11003000 {
			compatible = "mediatek,mt6577-uart";
			reg = <0x11003000 0x1000>;
			interrupts = <0x00 0x18e 0x04 0x00>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		usb0@11200000 {
			compatible = "mediatek,mt8518-musb", "mediatek,mtk-musb";
			reg = <0x11200000 0x10000>;
			interrupts = <0x00 0x80 0x04 0x00>;
			interrupt-names = "mc";
			phys = <0x0f 0x03>;
			clocks = <0x0e 0x0e 0x0e>;
			clock-names = "main", "mcu", "univpll";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;
			status = "okay";
			dr_mode = "peripheral";
			maximum-speed = "high-speed";
		};

		t-phy@11f40000 {
			compatible = "mediatek,mt6789-tphy", "mediatek,generic-tphy-v2";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x11f40000 0x1000>;
			status = "okay";

			usb-phy@0 {
				reg = <0x00 0x700>;
				clocks = <0x0e>;
				clock-names = "ref";
				#phy-cells = <0x01>;
				status = "okay";
				mediatek,eye-src = <0x04>;
				mediatek,eye-vrt = <0x04>;
				mediatek,eye-term = <0x04>;
				mediatek,discth = <0x07>;
				phandle = <0x0f>;
			};
		};

		mmc@11240000 {
			compatible = "mediatek,mt8183-mmc";
			reg = <0x11240000 0x1000 0x11ef0000 0x1000>;
			clocks = <0x10 0x74 0x11 0x15 0x11 0x1c>;
			clock-names = "source", "hclk", "source_cg";
			interrupts = <0x00 0x87 0x04 0x00>;
			bus-width = <0x04>;
			max-frequency = <0xbebc200>;
			ocr-voltage = <0x30000>;
			cap-sd-highspeed;
			vmmc-supply = <&mt6358_vmch_reg>;
			vqmmc-supply = <&mt6358_vmc_reg>;
			pinctrl-names = "default", "state_uhs";
			pinctrl-0 = <0x14>;
			pinctrl-1 = <0x14>;
			no-mmc;
			no-sdio;
			builtin-cd = <0x00>;
			status = "okay";
			r_smpl = <0x00>;
			/* CD is active-high (stock DT: <&pio 7 0>); with
			 * ACTIVE_LOW the driver probes a slot with no card.
			 */
			cd-gpios = <0x0d 0x07 0x00>;
		};


				ufs-phy@11fa0000 {
			compatible = "mediatek,mt6789-ufsphy", "mediatek,mt8183-ufsphy";
			reg = <0x11fa0000 0xc000>;
			clocks = <0x11 0x29 0x11 0x2b>;
			clock-names = "unipro", "mp";
			#phy-cells = <0x00>;
			phandle = <0x34>;
			status = "okay";
		};

ufshci@11270000 {
			compatible = "mediatek,mt6789-ufshci", "mediatek,mt8183-ufshci";
			reg = <0x11270000 0x2300>;
			interrupts = <0x00 0x89 0x04 0x00>;
			phys = <0x34>;
			clocks = <0x11 0x2f 0x10 0x86>;
			clock-names = "ufs", "ufs_sel";
			freq-table-hz = <0x00 0x00>, <0x00 0x00>;
			resets = <0x11 0x01 0x11 0x02 0x11 0x03>;
			reset-names = "hci_rst", "unipro_rst", "crypto_rst";
			mediatek,ufs-disable-mcq;
			mediatek,ufs-broken-vcc;
			status = "okay";
		
		};

		i2c@11e00000 {
			compatible = "mediatek,mt6789-i2c", "mediatek,mt8781-i2c";
